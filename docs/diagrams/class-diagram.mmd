classDiagram
    class User {
        +int id
        +string email
        +string full_name
        +string password_hash
        +Role role
        +bool is_blocked
        +datetime created_at
    }

    class Category {
        +int id
        +string name
        +string description
    }

    class Listing {
        +int id
        +string title
        +string description
        +float price
        +ListingStatus status
        +string rejection_reason
        +int owner_id
        +int category_id
        +datetime created_at
        +datetime updated_at
    }

    class ListingImage {
        +int id
        +int listing_id
        +string url
        +int position
    }

    class Message {
        +int id
        +int listing_id
        +int sender_id
        +int recipient_id
        +string body
        +datetime created_at
    }

    class AuthService
    class UserService
    class CategoryService
    class ListingService
    class MessageService
    class ModerationService
    class Repository~T~
    class ListingSortStrategy
    class DatabaseClientFactory

    User "1" --> "*" Listing : owns
    Category "1" --> "*" Listing : classifies
    Listing "1" --> "*" ListingImage : has
    Listing "1" --> "*" Message : contains
    User "1" --> "*" Message : sends
    User "1" --> "*" Message : receives

    AuthService --> Repository~T~
    UserService --> Repository~T~
    CategoryService --> Repository~T~
    ListingService --> Repository~T~
    MessageService --> Repository~T~
    ModerationService --> Repository~T~
    ListingService --> ListingSortStrategy
    Repository~T~ --> DatabaseClientFactory
